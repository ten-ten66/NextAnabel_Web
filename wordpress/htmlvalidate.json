{
  "root": true,
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "attribute-boolean-style": "off",
    "doctype-style": "off",
    "long-title": "off",
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "require-sri": "off",
    "tel-non-breaking": "off",
    "void-style": "off",
    "attr-quotes": "off"
  }
}