          "Fraunces",
          "Georgia",
          "serif"
        ],
        "$description": "欧文の装飾用。Google Fonts の text= で必要な文字だけ読み込む"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
