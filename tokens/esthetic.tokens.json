    "linen": {
      "$value": "#ECEEE6",
      "$description": "ページ背景（麻）"
    },
    "paper": {
      "$value": "#F6F7F2",
      "$description": "面"
    },
    "stone": {
      "$value": "#CFCBC0",
      "$description": "罫線・石"
    },
    "lichen": {
      "$value": "#A8B394",
      "$description": "淡い緑"
    },
    "moss": {
      "$value": "#2F3B2B",
      "$description": "本文・濃色"
    },
    "moss-soft": {
      "$value": "#56664F",
      "$description": "補足テキスト"
    },
    "mauve": {
